# All optional. Without them the app still runs (rules-based chatbot, schematic map, on-screen email preview).

# Admin dashboard login. Defaults to admin / admin123 when ADMIN_PASSWORD is unset.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Set to "open" to switch the login off (for a judging link that needs no login).
ADMIN_AUTH=

# Chatbot / Expansion Copilot (Gemini). Nothing is called until all three are set.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=

# Maps (Geoapify tiles + pin-code geocoding)
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Candidate confirmation email via Resend
RESEND_API_KEY=
MAIL_FROM=
# Where candidates' replies go, and the address shown in decision emails ("Email us your changes")
MAIL_REPLY_TO=
NEXT_PUBLIC_CONTACT_EMAIL=

# Data-protection contact shown in the consent text
NEXT_PUBLIC_DPO_EMAIL=
